# Внутренний Caddy контейнера olpest-web.
# Он НЕ занимает порты 80/443 сервера и не получает сертификаты:
# это делает Caddy от Omad, который проксирует домен сюда.
{
	auto_https off
	admin off
}

:80 {
	root * /srv
	encode zstd gzip
	file_server

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# three.js и шрифты не меняются — кеш на год
	@static path /assets/vendor/* /assets/fonts/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	# страница, стили, код — браузер перепроверяет при каждом заходе
	@fresh not path /assets/vendor/* /assets/fonts/*
	header @fresh Cache-Control "no-cache"
}
